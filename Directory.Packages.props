<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Broiler.Documents.Pagination paints Broiler.Graphics.Paging pages, which arrive in
         0.1.0-preview.13. A property, so a build against a local pack can name it with
         -p:BroilerGraphicsVersion=... -->
    <BroilerGraphicsVersion Condition="'$(BroilerGraphicsVersion)' == ''">0.1.0-preview.13</BroilerGraphicsVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Broiler.Dom" Version="0.1.0-preview.14" />
    <PackageVersion Include="Broiler.Dom.Html" Version="0.1.0-preview.14" />
    <PackageVersion Include="Broiler.Graphics" Version="$(BroilerGraphicsVersion)" />
    <PackageVersion Include="Broiler.Media.Image.Managed" Version="0.1.0-preview.15" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <!-- Tests only: the recipient decryptor a host would compose for certificate
         encryption (IP-025). ADR 0001 keeps it out of every shipped assembly. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.12" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="Xunit.SkippableFact" Version="1.5.85" />
  </ItemGroup>
</Project>