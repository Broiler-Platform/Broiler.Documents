<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Broiler.Dom" Version="0.1.0-preview.8" />
    <PackageVersion Include="Broiler.Dom.Html" Version="0.1.0-preview.8" />
    <PackageVersion Include="Broiler.Graphics" Version="0.1.0-preview.6" />
    <PackageVersion Include="Broiler.Media.Image.Managed" Version="0.1.0-preview.14" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <!-- Tests only: the recipient decryptor a host would compose for certificate
         encryption (IP-025). ADR 0001 keeps it out of every shipped assembly. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.12" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="Xunit.SkippableFact" Version="1.5.85" />
  </ItemGroup>
</Project>