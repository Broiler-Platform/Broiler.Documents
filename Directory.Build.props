<Project>

  <!-- Broiler NuGet packaging metadata (vendored; do not edit by hand). -->
  <Import Project="$(MSBuildThisFileDirectory)eng\Broiler.Packaging.props" />

  <PropertyGroup>
    <BroilerBaseConfiguration Condition="'$(Configuration)' == 'Debug-Linux' Or '$(Configuration)' == 'Debug-Windows'">Debug</BroilerBaseConfiguration>
    <BroilerBaseConfiguration Condition="'$(Configuration)' == 'Release-Linux' Or '$(Configuration)' == 'Release-Windows'">Release</BroilerBaseConfiguration>

    <DebugSymbols Condition="'$(BroilerBaseConfiguration)' == 'Debug'">true</DebugSymbols>
    <DebugType Condition="'$(BroilerBaseConfiguration)' == 'Debug'">portable</DebugType>
    <Optimize Condition="'$(BroilerBaseConfiguration)' == 'Debug'">false</Optimize>
    <DefineConstants Condition="'$(BroilerBaseConfiguration)' == 'Debug'">$(DefineConstants);DEBUG</DefineConstants>
    <DebugType Condition="'$(BroilerBaseConfiguration)' == 'Release'">portable</DebugType>
    <Optimize Condition="'$(BroilerBaseConfiguration)' == 'Release'">true</Optimize>
  </PropertyGroup>

  <!-- Component-owned overrides. These are evaluated AFTER the import above and
       therefore win, which is the extension point the vendored file documents.
       The shared default points at the organisation; a published package should
       link to the component's own repository instead. Authors, license, and the
       rest of the identity come from the vendored file. -->
  <PropertyGroup>
    <PackageProjectUrl>https://github.com/Broiler-Platform/Broiler.Documents</PackageProjectUrl>
    <PackageTags>broiler;documents;rich-text;codec;rtf;docx;odt;opendocument;html;markdown;csv;xlsx;ods;spreadsheet</PackageTags>
  </PropertyGroup>

  <!-- NU1603 (a dependency resolved to a higher preview than it asked for) stays a
       warning rather than an error. It happens when an upstream Broiler package
       names a preview its feed does not carry, e.g. Broiler.Graphics asking for a
       Broiler.Media.Image preview that nuget.org skipped; the next preview is
       acceptable. -->
  <PropertyGroup>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1603</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
