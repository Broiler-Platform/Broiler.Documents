# Shell scripts must keep LF endings whatever a contributor's core.autocrlf is
# set to. Anything under eng/ may run on the Ubuntu CI runner, where CRLF would
# make the shebang fail with "bad interpreter: /usr/bin/env bash^M".
*.sh text eol=lf

# The corpus suite's data files are regenerated by a runner that may run on
# either CI leg, and JSON writers take their newline from the environment. Git
# normalises nothing else in this repository, so without this a regeneration on
# Windows would commit a whole-file diff against one generated on Linux and
# neither would be wrong.
tests/corpus/*.json text eol=lf
