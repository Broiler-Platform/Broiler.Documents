<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Restore sources for a publish to GitHub Packages. CI copies this file over the
    root NuGet.config before the first restore (see ci.yml, "Select restore feeds").

    Broiler.* resolves from the Broiler-Platform GitHub Packages feed only, so the
    published packages depend on versions that feed actually carries; everything
    else resolves from nuget.org. CI supplies the feed credentials through
    NuGetPackageSourceCredentials_broiler-github. Never commit a token here.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="broiler-github" value="https://nuget.pkg.github.com/Broiler-Platform/index.json" />
  </packageSources>
  <disabledPackageSources><clear /></disabledPackageSources>

  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="broiler-github">
      <package pattern="Broiler.*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
