<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Restore sources for a publish to nuget.org. CI copies this file over the root
    NuGet.config before the first restore (see ci.yml, "Select restore feeds").

    Everything, including every Broiler.* dependency, resolves from nuget.org only.
    A package built this way cannot depend on a version that exists only on GitHub
    Packages, so a nuget.org consumer can always restore what is published.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <disabledPackageSources><clear /></disabledPackageSources>

  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
