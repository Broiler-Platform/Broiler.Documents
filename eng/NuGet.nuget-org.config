<?xml version="1.0" encoding="utf-8"?>
<!-- Restore sources for a NuGet.org publish. CI copies this over NuGet.config so the
     release builds only against packages a NuGet.org consumer can restore. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
