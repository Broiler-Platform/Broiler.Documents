<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Restore sources for Broiler.Documents.

    <clear /> drops whatever sources the machine happens to have configured, so a
    restore resolves the same way on every developer box and in CI.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="broiler-github" value="https://nuget.pkg.github.com/Broiler-Platform/index.json" />
  </packageSources>
  <disabledPackageSources><clear /></disabledPackageSources>

  <!--
    Source mapping keeps the two feeds in their lanes. Broiler.* is looked up on BOTH
    the Broiler-Platform GitHub Packages feed and nuget.org: NuGet uses the most
    specific matching pattern, and because Broiler.* is listed under both sources,
    each pinned Broiler version resolves from whichever feed has it. Everything else
    resolves from nuget.org only.

    Mapping selects sources per package ID, not per version; the exact versions stay
    pinned in Directory.Packages.props. The GitHub feed requires read:packages
    authentication even for public packages, and it is always queried for Broiler.*,
    so a restore still needs those credentials. CI supplies its job token through
    NuGet's credential environment variable; developers configure credentials outside
    this repository.

    Credentials are deliberately absent. Never commit a token here; see the README
    section "Consuming Broiler packages from GitHub Packages".
  -->
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="Broiler.*" />
    </packageSource>
    <packageSource key="broiler-github">
      <package pattern="Broiler.*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
