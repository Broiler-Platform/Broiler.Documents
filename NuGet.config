<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Restore sources for Broiler.Documents.

    <clear /> drops whatever sources the machine happens to have configured, so a
    restore resolves the same way on every developer box and in CI.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="broiler-github" value="https://nuget.pkg.github.com/Broiler-Platform/index.json" />
  </packageSources>

  <!--
    Source mapping keeps the two feeds in their lanes. Broiler.* may come from the
    Broiler-Platform GitHub Packages feed or from nuget.org once published; everything
    else resolves from nuget.org only.

    This is also what keeps the build working without credentials. GitHub Packages
    requires authentication even for public packages, so an unmapped source would be
    queried for every package and answer 401. With the mapping below it is contacted
    only for Broiler.*, and this repository takes its Broiler dependencies through the
    submodules as project references, so nothing queries it today.

    Credentials are deliberately absent. Never commit a token here; see the README
    section "Consuming Broiler packages from GitHub Packages".
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="broiler-github">
      <package pattern="Broiler.*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
