{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Known encrypted inputs for normalized re-save conformance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "corpusRevision",
    "source",
    "samples"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "corpusRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source": {
      "type": "string",
      "format": "uri"
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sha256",
          "reason",
          "expectedExitCode"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "expectedExitCode": {
            "const": 3
          }
        }
      }
    }
  }
}
