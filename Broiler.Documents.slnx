<Solution>
  <Configurations>
    <BuildType Name="Debug" />
    <BuildType Name="Release" />
    <BuildType Name="Debug-Linux" />
    <BuildType Name="Release-Linux" />
    <BuildType Name="Debug-Windows" />
    <BuildType Name="Release-Windows" />
  </Configurations>
  <Folder Name="/solution items/">
    <File Path="Directory.Build.props" />
    <File Path="LICENSE" />
    <File Path="NuGet.config" />
    <File Path="README.md" />
    <File Path=".gitattributes" />
    <File Path=".gitignore" />
    <File Path=".gitmodules" />
  </Folder>
  <Folder Name="/solution items/eng/">
    <File Path="eng/Broiler.Packaging.props" />
  </Folder>
  <Folder Name="/solution items/docs/">
    <File Path="docs/roadmap.md" />
    <File Path="docs/cli.md" />
  </Folder>
  <!--
    Every project here is platform-neutral net10.0, so all six configurations
    build all twenty-four. The suffixed configurations exist to line this component
    up with the rest of the suite, where the Windows and Linux backends are real
    build targets; they map onto plain Debug / Release here.

    The two external dependencies - Broiler.Graphics (document model) and
    Broiler.Dom / Broiler.Dom.Html (HTML codec) - come in through the submodules
    at the repository root as project references. They are deliberately not
    listed as solution projects: they build transitively and are owned by their
    own repositories.

    Listed in dependency order.
  -->
  <Folder Name="/src/">
    <Project Path="src/Broiler.Documents.Model/Broiler.Documents.Model.csproj">
      <BuildType Project="Debug" Solution="Debug-Linux|*" />
      <BuildType Project="Release" Solution="Release-Linux|*" />
      <BuildType Project="Debug" Solution="Debug-Windows|*" />
      <BuildType Project="Release" Solution="Release-Windows|*" />
    </Project>
    <Project Path="src/Broiler.Documents.FormatCodes/Broiler.Documents.FormatCodes.csproj">
      <BuildType Project="Debug" Solution="Debug-Linux|*" />
      <BuildType Project="Release" Solution="Release-Linux|*" />
      <BuildType Project="Debug" Solution="Debug-Windows|*" />
      <BuildType Project="Release" Solution="Release-Windows|*" />
    </Project>
    <Project Path="src/Broiler.Documents/Broiler.Documents.csproj">
      <BuildType Project="Debug" Solution="Debug-Linux|*" />
      <BuildType Project="Release" Solution="Release-Linux|*" />
      <BuildType Project="Debug" Solution="Debug-Windows|*" />
      <BuildType Project="Release" Solution="Release-Windows|*" />
    </Project>
    <Project Path="src/Broiler.Documents.Rtf/Broiler.Documents.Rtf.csproj">
      <BuildType Project="Debug" Solution="Debug-Linux|*" />
      <BuildType Project="Release" Solution="Release-Linux|*" />
      <BuildType Project="Debug" Solution="Debug-Windows|*" />
      <BuildType Project="Release" Solution="Release-Windows|*" />
    </Project>
    <Project Path="src/Broiler.Documents.Docx/Broiler.Documents.Docx.csproj">
      <BuildType Project="Debug" Solution="Debug-Linux|*" />
      <BuildType Project="Release" Solution="Release-Linux|*" />
      <BuildType Project="Debug" Solution="Debug-Windows|*" />
      <BuildType Project="Release" Solution="Release-Windows|*" />
    </Project>
    <Project Path="src/Broiler.Documents.Odt/Broiler.Documents.Odt.csproj">
      <BuildType Project="Debug" Solution="Debug-Linux|*" />
      <BuildType Project="Release" Solution="Release-Linux|*" />
      <BuildType Project="Debug" Solution="Debug-Windows|*" />
      <BuildType Project="Release" Solution="Release-Windows|*" />
    </Project>
    <Project Path="src/Broiler.Documents.Html/Broiler.Documents.Html.csproj">
      <BuildType Project="Debug" Solution="Debug-Linux|*" />
      <BuildType Project="Release" Solution="Release-Linux|*" />
      <BuildType Project="Debug" Solution="Debug-Windows|*" />
      <BuildType Project="Release" Solution="Release-Windows|*" />
    </Project>
    <Project Path="src/Broiler.Documents.Markdown/Broiler.Documents.Markdown.csproj">
      <BuildType Project="Debug" Solution="Debug-Linux|*" />
      <BuildType Project="Release" Solution="Release-Linux|*" />
      <BuildType Project="Debug" Solution="Debug-Windows|*" />
      <BuildType Project="Release" Solution="Release-Windows|*" />
    </Project>
    <!-- In-solution only: IsPackable=false until the PDF delivery gates pass
         (docs/pdf-support-roadmap.md 4.1). It still builds and tests here. -->
    <Project Path="src/Broiler.Documents.Pdf/Broiler.Documents.Pdf.csproj">
      <BuildType Project="Debug" Solution="Debug-Linux|*" />
      <BuildType Project="Release" Solution="Release-Linux|*" />
      <BuildType Project="Debug" Solution="Debug-Windows|*" />
      <BuildType Project="Release" Solution="Release-Windows|*" />
    </Project>
    <!-- Composable PDF image filters. Separate from the codec so that a host
         composing no image decoder links no image decoder; gated on the
         IP/licensing register per filter (docs/pdf-ip-licensing-register.md). -->
    <Project Path="src/Broiler.Documents.Pdf.Images/Broiler.Documents.Pdf.Images.csproj">
      <BuildType Project="Debug" Solution="Debug-Linux|*" />
      <BuildType Project="Release" Solution="Release-Linux|*" />
      <BuildType Project="Debug" Solution="Debug-Windows|*" />
      <BuildType Project="Release" Solution="Release-Windows|*" />
    </Project>
    <Project Path="src/Broiler.Documents.Pdf.Fonts/Broiler.Documents.Pdf.Fonts.csproj">
      <BuildType Project="Debug" Solution="Debug-Linux|*" />
      <BuildType Project="Release" Solution="Release-Linux|*" />
      <BuildType Project="Debug" Solution="Debug-Windows|*" />
      <BuildType Project="Release" Solution="Release-Windows|*" />
    </Project>
    <!-- Application head, not a published capability. IsPackable=false keeps the
         component's package set at the eight libraries the README lists; see the
         project file for how to ship it as a dotnet tool. -->
    <Project Path="src/Broiler.Documents.Cli/Broiler.Documents.Cli.csproj">
      <BuildType Project="Debug" Solution="Debug-Linux|*" />
      <BuildType Project="Release" Solution="Release-Linux|*" />
      <BuildType Project="Debug" Solution="Debug-Windows|*" />
      <BuildType Project="Release" Solution="Release-Windows|*" />
    </Project>
  </Folder>
  <Folder Name="/tests/">
    <Project Path="src/tests/Broiler.Documents.Model.Tests/Broiler.Documents.Model.Tests.csproj">
      <BuildType Project="Debug" Solution="Debug-Linux|*" />
      <BuildType Project="Release" Solution="Release-Linux|*" />
      <BuildType Project="Debug" Solution="Debug-Windows|*" />
      <BuildType Project="Release" Solution="Release-Windows|*" />
    </Project>
    <Project Path="src/tests/Broiler.Documents.FormatCodes.Tests/Broiler.Documents.FormatCodes.Tests.csproj">
      <BuildType Project="Debug" Solution="Debug-Linux|*" />
      <BuildType Project="Release" Solution="Release-Linux|*" />
      <BuildType Project="Debug" Solution="Debug-Windows|*" />
      <BuildType Project="Release" Solution="Release-Windows|*" />
    </Project>
    <Project Path="src/tests/Broiler.Documents.Tests/Broiler.Documents.Tests.csproj">
      <BuildType Project="Debug" Solution="Debug-Linux|*" />
      <BuildType Project="Release" Solution="Release-Linux|*" />
      <BuildType Project="Debug" Solution="Debug-Windows|*" />
      <BuildType Project="Release" Solution="Release-Windows|*" />
    </Project>
    <Project Path="src/tests/Broiler.Documents.Rtf.Tests/Broiler.Documents.Rtf.Tests.csproj">
      <BuildType Project="Debug" Solution="Debug-Linux|*" />
      <BuildType Project="Release" Solution="Release-Linux|*" />
      <BuildType Project="Debug" Solution="Debug-Windows|*" />
      <BuildType Project="Release" Solution="Release-Windows|*" />
    </Project>
    <Project Path="src/tests/Broiler.Documents.Docx.Tests/Broiler.Documents.Docx.Tests.csproj">
      <BuildType Project="Debug" Solution="Debug-Linux|*" />
      <BuildType Project="Release" Solution="Release-Linux|*" />
      <BuildType Project="Debug" Solution="Debug-Windows|*" />
      <BuildType Project="Release" Solution="Release-Windows|*" />
    </Project>
    <Project Path="src/tests/Broiler.Documents.Odt.Tests/Broiler.Documents.Odt.Tests.csproj">
      <BuildType Project="Debug" Solution="Debug-Linux|*" />
      <BuildType Project="Release" Solution="Release-Linux|*" />
      <BuildType Project="Debug" Solution="Debug-Windows|*" />
      <BuildType Project="Release" Solution="Release-Windows|*" />
    </Project>
    <Project Path="src/tests/Broiler.Documents.Html.Tests/Broiler.Documents.Html.Tests.csproj">
      <BuildType Project="Debug" Solution="Debug-Linux|*" />
      <BuildType Project="Release" Solution="Release-Linux|*" />
      <BuildType Project="Debug" Solution="Debug-Windows|*" />
      <BuildType Project="Release" Solution="Release-Windows|*" />
    </Project>
    <Project Path="src/tests/Broiler.Documents.Markdown.Tests/Broiler.Documents.Markdown.Tests.csproj">
      <BuildType Project="Debug" Solution="Debug-Linux|*" />
      <BuildType Project="Release" Solution="Release-Linux|*" />
      <BuildType Project="Debug" Solution="Debug-Windows|*" />
      <BuildType Project="Release" Solution="Release-Windows|*" />
    </Project>
    <Project Path="src/tests/Broiler.Documents.Pdf.Tests/Broiler.Documents.Pdf.Tests.csproj">
      <BuildType Project="Debug" Solution="Debug-Linux|*" />
      <BuildType Project="Release" Solution="Release-Linux|*" />
      <BuildType Project="Debug" Solution="Debug-Windows|*" />
      <BuildType Project="Release" Solution="Release-Windows|*" />
    </Project>
    <Project Path="src/tests/Broiler.Documents.Pdf.Images.Tests/Broiler.Documents.Pdf.Images.Tests.csproj">
      <BuildType Project="Debug" Solution="Debug-Linux|*" />
      <BuildType Project="Release" Solution="Release-Linux|*" />
      <BuildType Project="Debug" Solution="Debug-Windows|*" />
      <BuildType Project="Release" Solution="Release-Windows|*" />
    </Project>
    <Project Path="src/tests/Broiler.Documents.Pdf.Fonts.Tests/Broiler.Documents.Pdf.Fonts.Tests.csproj">
      <BuildType Project="Debug" Solution="Debug-Linux|*" />
      <BuildType Project="Release" Solution="Release-Linux|*" />
      <BuildType Project="Debug" Solution="Debug-Windows|*" />
      <BuildType Project="Release" Solution="Release-Windows|*" />
    </Project>
    <Project Path="src/tests/Broiler.Documents.Cli.Tests/Broiler.Documents.Cli.Tests.csproj">
      <BuildType Project="Debug" Solution="Debug-Linux|*" />
      <BuildType Project="Release" Solution="Release-Linux|*" />
      <BuildType Project="Debug" Solution="Debug-Windows|*" />
      <BuildType Project="Release" Solution="Release-Windows|*" />
    </Project>
    <!-- A console runner rather than a test project: it drives the built
         broilerdoc executable as a child process, so it needs that executable to
         exist before it runs, and `dotnet test` discovers nothing in it. CI runs
         it in its own step and reads its count line. See docs/corpus-suite.md. -->
    <Project Path="src/tests/Broiler.Documents.Corpus/Broiler.Documents.Corpus.csproj">
      <BuildType Project="Debug" Solution="Debug-Linux|*" />
      <BuildType Project="Release" Solution="Release-Linux|*" />
      <BuildType Project="Debug" Solution="Debug-Windows|*" />
      <BuildType Project="Release" Solution="Release-Windows|*" />
    </Project>
    <!-- The office conformance suite, and a console runner for the same reasons
         the corpus one is. It differs in what it is evidence about: LibreOffice
         writes the documents, so the markup broilerdoc is asked to read was
         produced by an implementation that knows nothing about this one. It is
         not run by CI on a pull request - it depends on a third-party binary
         whose rows in tests/office/tools/manifest.json are still pending. See
         docs/office-conformance.md. -->
    <Project Path="src/tests/Broiler.Documents.Office/Broiler.Documents.Office.csproj">
      <BuildType Project="Debug" Solution="Debug-Linux|*" />
      <BuildType Project="Release" Solution="Release-Linux|*" />
      <BuildType Project="Debug" Solution="Debug-Windows|*" />
      <BuildType Project="Release" Solution="Release-Windows|*" />
    </Project>
  </Folder>
</Solution>
