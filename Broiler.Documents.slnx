<Solution>
  <Configurations>
    <BuildType Name="Debug" />
    <BuildType Name="Release" />
    <BuildType Name="Debug-Linux" />
    <BuildType Name="Release-Linux" />
    <BuildType Name="Debug-Windows" />
    <BuildType Name="Release-Windows" />
  </Configurations>
  <Folder Name="/solution items/">
    <File Path="Directory.Build.props" />
    <File Path="LICENSE" />
    <File Path="NuGet.config" />
    <File Path="README.md" />
    <File Path=".gitattributes" />
    <File Path=".gitignore" />
    <File Path=".gitmodules" />
  </Folder>
  <Folder Name="/solution items/eng/">
    <File Path="eng/Broiler.Packaging.props" />
  </Folder>
  <Folder Name="/solution items/docs/">
    <File Path="docs/roadmap.md" />
    <File Path="docs/cli.md" />
  </Folder>
  <!--
    Every project here is platform-neutral net10.0, so all six configurations
    build all twenty. The suffixed configurations exist to line this component
    up with the rest of the suite, where the Windows and Linux backends are real
    build targets; they map onto plain Debug / Release here.

    The two external dependencies - Broiler.Graphics (document model) and
    Broiler.Dom / Broiler.Dom.Html (HTML codec) - come in through the submodules
    at the repository root as project references. They are deliberately not
    listed as solution projects: they build transitively and are owned by their
    own repositories.

    Listed in dependency order.
  -->
  <Folder Name="/src/">
    <Project Path="src/Broiler.Documents.Model/Broiler.Documents.Model.csproj">
      <BuildType Project="Debug" Solution="Debug-Linux|*" />
      <BuildType Project="Release" Solution="Release-Linux|*" />
      <BuildType Project="Debug" Solution="Debug-Windows|*" />
      <BuildType Project="Release" Solution="Release-Windows|*" />
    </Project>
    <Project Path="src/Broiler.Documents.FormatCodes/Broiler.Documents.FormatCodes.csproj">
      <BuildType Project="Debug" Solution="Debug-Linux|*" />
      <BuildType Project="Release" Solution="Release-Linux|*" />
      <BuildType Project="Debug" Solution="Debug-Windows|*" />
      <BuildType Project="Release" Solution="Release-Windows|*" />
    </Project>
    <Project Path="src/Broiler.Documents/Broiler.Documents.csproj">
      <BuildType Project="Debug" Solution="Debug-Linux|*" />
      <BuildType Project="Release" Solution="Release-Linux|*" />
      <BuildType Project="Debug" Solution="Debug-Windows|*" />
      <BuildType Project="Release" Solution="Release-Windows|*" />
    </Project>
    <Project Path="src/Broiler.Documents.Rtf/Broiler.Documents.Rtf.csproj">
      <BuildType Project="Debug" Solution="Debug-Linux|*" />
      <BuildType Project="Release" Solution="Release-Linux|*" />
      <BuildType Project="Debug" Solution="Debug-Windows|*" />
      <BuildType Project="Release" Solution="Release-Windows|*" />
    </Project>
    <Project Path="src/Broiler.Documents.Docx/Broiler.Documents.Docx.csproj">
      <BuildType Project="Debug" Solution="Debug-Linux|*" />
      <BuildType Project="Release" Solution="Release-Linux|*" />
      <BuildType Project="Debug" Solution="Debug-Windows|*" />
      <BuildType Project="Release" Solution="Release-Windows|*" />
    </Project>
    <Project Path="src/Broiler.Documents.Odt/Broiler.Documents.Odt.csproj">
      <BuildType Project="Debug" Solution="Debug-Linux|*" />
      <BuildType Project="Release" Solution="Release-Linux|*" />
      <BuildType Project="Debug" Solution="Debug-Windows|*" />
      <BuildType Project="Release" Solution="Release-Windows|*" />
    </Project>
    <Project Path="src/Broiler.Documents.Html/Broiler.Documents.Html.csproj">
      <BuildType Project="Debug" Solution="Debug-Linux|*" />
      <BuildType Project="Release" Solution="Release-Linux|*" />
      <BuildType Project="Debug" Solution="Debug-Windows|*" />
      <BuildType Project="Release" Solution="Release-Windows|*" />
    </Project>
    <Project Path="src/Broiler.Documents.Markdown/Broiler.Documents.Markdown.csproj">
      <BuildType Project="Debug" Solution="Debug-Linux|*" />
      <BuildType Project="Release" Solution="Release-Linux|*" />
      <BuildType Project="Debug" Solution="Debug-Windows|*" />
      <BuildType Project="Release" Solution="Release-Windows|*" />
    </Project>
    <!-- In-solution only: IsPackable=false until the PDF delivery gates pass
         (docs/pdf-support-roadmap.md 4.1). It still builds and tests here. -->
    <Project Path="src/Broiler.Documents.Pdf/Broiler.Documents.Pdf.csproj">
      <BuildType Project="Debug" Solution="Debug-Linux|*" />
      <BuildType Project="Release" Solution="Release-Linux|*" />
      <BuildType Project="Debug" Solution="Debug-Windows|*" />
      <BuildType Project="Release" Solution="Release-Windows|*" />
    </Project>
    <!-- Application head, not a published capability. IsPackable=false keeps the
         component's package set at the eight libraries the README lists; see the
         project file for how to ship it as a dotnet tool. -->
    <Project Path="src/Broiler.Documents.Cli/Broiler.Documents.Cli.csproj">
      <BuildType Project="Debug" Solution="Debug-Linux|*" />
      <BuildType Project="Release" Solution="Release-Linux|*" />
      <BuildType Project="Debug" Solution="Debug-Windows|*" />
      <BuildType Project="Release" Solution="Release-Windows|*" />
    </Project>
  </Folder>
